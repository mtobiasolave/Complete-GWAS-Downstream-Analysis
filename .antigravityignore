# Snakemake internal cache & metadata
.snakemake/

# Large input data and generated outputs
data/
results/
logs/

# Python cache & temporary files
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.bak

# Raw GTF annotations, Excel workbooks & compressed archives (safety net)
*.gtf
*.gtf.*
*.gtf_withproteinids
*.xlsx
*.gz
*.tar
*.zip
*.bgz
*.bam
*.bai
*.vcf
*.bed
*.bim
*.fam
*.rds
*.RData
*.h5
*.parquet
*.feather
*.ldscore

# Allow small schema/header sample files if you create a 'schemas/' folder later
!schemas/*.txt